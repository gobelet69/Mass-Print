{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mass Print",
  "version": "0.1.4",
  "identifier": "com.massprint.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mass Print",
        "width": 900,
        "height": 650,
        "minWidth": 640,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../finder/Print with Mass Print.workflow/": "finder/Print with Mass Print.workflow/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Print multiple documents in the order you choose.",
    "longDescription": "Mass Print is a lightweight macOS utility for arranging and printing multiple local documents in a controlled sequence.",
    "fileAssociations": [
      {
        "ext": ["pdf", "png", "jpg", "jpeg", "tif", "tiff", "txt", "rtf", "doc", "docx", "odt", "html", "htm", "xls", "xlsx", "ppt", "pptx", "ods", "odp"],
        "name": "Printable Document",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": null
    }
  }
}

